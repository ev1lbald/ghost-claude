{
  "name": "ghost-claude",
  "version": "0.1.0",
  "description": "Невидимый оверлей-ассистент для macOS на вашей подписке Claude",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac",
    "spike": "node spike/spike.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@anthropic-ai/sdk": "^0.134.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "build": {
    "appId": "dev.ghostclaude.app",
    "productName": "Ghost Claude",
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Для расшифровки речи на созвонах",
        "NSScreenCaptureUsageDescription": "Для скриншотов экрана, которые вы отправляете Claude"
      }
    }
  }
}
